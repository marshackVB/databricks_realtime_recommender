# COMMAND ----------

# MAGIC %md
# MAGIC #### Step 1: Split features into daily batch and real-time aggregate features.
# MAGIC Daily batch features are product-level features, including product ID, product category, and price. These features are updated as part of a batch job. Real-time aggregate features include two types of features, product-level aggegates and user session-level aggregates. Both of these features types are derived from sessions-level clickstream data, they exist in different online tables and their computation frequency is different.
# MAGIC
# MAGIC Product-level aggregates are computed on session-level data, but they are update on a schedule cadence. Thinks of features like the number of purchases of a product over the past 7 days. These feature do not need to be calculated in near real time.
# MAGIC
# MAGIC User session-level aggregates are capture in near real time via a StreamSource. These features are derived from a user's actions while browsing the website. They exist in their own Lakebase table. The StreamSource writes non-aggregated, raw clickstream events to a Delta table. This Delta table is used as a source to Derive product-level features.

# COMMAND ----------

from pyspark.sql import functions as F
from databricks.feature_engineering import FeatureEngineeringClient
from databricks.feature_engineering.entities import (
    DeltaTableSource, Feature, AggregationFunction,
    Count, Max, Min, SlidingWindow, Sum, Avg,
    StddevPop, RollingWindow,RequestSource, FieldDefinition, 
    ScalarDataType,  ColumnSelection, OfflineStoreConfig, 
    OnlineStoreConfig, CronSchedule, TableTrigger,
)

from datetime import timedelta

fe = FeatureEngineeringClient()

# COMMAND ----------

# DBTITLE 1,Load config and define constants
import yaml
import os
from databricks.feature_engineering import FeatureEngineeringClient

# Load project config
config_path = os.path.join(os.getcwd(), "config.yml")
with open(config_path) as f:
